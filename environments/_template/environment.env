# Settings for one environment (one Google SecOps instance). Copied by "yadda new <name>".

# --- SecOps API access (optional; without it, put the query exports in inputs/ yourself)
# Region endpoint and instance: SecOps > Settings > SIEM Settings > Profile shows the project, region and "Customer ID".
GOOGLE_SECOPS_API_BASE_URL=https://eu-chronicle.googleapis.com/v1alpha
GOOGLE_SECOPS_API_UPLOAD_BASE_URL=https://eu-chronicle.googleapis.com/upload/v1alpha
GOOGLE_SECOPS_INSTANCE=projects/PROJECT_ID/locations/eu/instances/INSTANCE_ID
AUTHORIZATION_SCOPES={"GOOGLE_SECOPS_API":["https://www.googleapis.com/auth/cloud-platform"]}
LOGGING_LEVEL=INFO

# Sign in with a different Google account for this environment (see docs/setup.md). Leave unset to use your default.
#GOOGLE_APPLICATION_CREDENTIALS=~/.gcloud-NAME/application_default_credentials.json

# --- Scope
# ATT&CK platforms this environment has. Leave unset and every platform is assessed. Options:
# Windows, Linux, macOS, Identity Provider, Office Suite, SaaS, IaaS, Network Devices, Containers, ESXi
#PLATFORMS=Windows,Linux,Identity Provider,Office Suite,SaaS

# Threat groups, campaigns or threat-intel files (shared/threat-intel) to measure coverage against.
# "yadda actors --sector ... --country ... --environment NAME --set" fills this in.
#THREATS=APT29,FIN7

# --- Evidence thresholds (defaults shown)
#EVIDENCE_DAYS=90
#FP_MAX=50
#MIN_CASES=5
